# ==============================================================================
# Lakehouse Hybrid RAG Chatbot — Environment Configuration
# ==============================================================================

# PostgreSQL + pgvector
POSTGRES_DB=lakehouse_db
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=lakehouse_secret
POSTGRES_PORT=5435
# Use host 'postgres:5432' inside Docker Compose; 'localhost:<POSTGRES_PORT>' when running engines locally
DATABASE_URL=postgresql://lakehouse:lakehouse_secret@localhost:5435/lakehouse_db

# MinIO (S3-compatible Lakehouse Storage)
# Use 'http://minio:9000' inside Docker Compose; 'http://localhost:9000' locally
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lakehouse
MINIO_BUCKET_QUOTA=2GB
AWS_REGION=us-east-1

# Fixed External Embedding Model (shared by data-engine and rag-engine)
# Note: pgvector HNSW index requires EMBEDDING_DIM <= 2000 (768 or 1536 recommended)
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIM=768

# Dynamic Chat LLM API Keys (configure any providers you want in the UI dropdown)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_API_BASE=http://host.docker.internal:11434

# Optional System Prompt Override
DEFAULT_SYSTEM_PROMPT=
